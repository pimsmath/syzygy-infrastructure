[nodesource-nodejs]
name=Node.js Packages for Linux RPM based distros - {{ ansible_facts['architecture'] }}
baseurl=https://rpm.nodesource.com/pub_{{ nodejs_version}}/nodistro/nodejs/{{ ansible_facts['architecture'] }}
priority=9
enabled=1
gpgcheck=1
gpgkey=https://rpm.nodesource.com/gpgkey/ns-operations-public.key
module_hotfixes=1

[nodesource-nsolid]
name=N|Solid Packages for Linux RPM based distros - {{ ansible_facts['architecture'] }}
baseurl=https://rpm.nodesource.com/pub_{{ nodejs_version }}/nodistro/nsolid/{{ ansible_facts['architecture'] }}
priority=9
enabled=1
gpgcheck=1
gpgkey=https://rpm.nodesource.com/gpgkey/ns-operations-public.key
module_hotfixes=1
